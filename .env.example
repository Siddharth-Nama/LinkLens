# Server
PORT=8080
LOG_LEVEL=info

# LinkedIn session cookies (required for profile lookups)
# Copy from browser DevTools while logged into linkedin.com
LI_AT=
LI_JSESSIONID=

# Optional: protect /v1/profiles when deployed publicly
API_KEY=

# Timeouts
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
LINKEDIN_TIMEOUT=20s

# Cache successful profile responses (0 disables cache)
CACHE_TTL=15m
